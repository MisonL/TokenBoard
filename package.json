{
  "name": "tokenboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.21.0",
  "scripts": {
    "dev": "pnpm --filter @tokenboard/web dev",
    "build": "pnpm --filter @tokenboard/web build",
    "preview": "pnpm --filter @tokenboard/web preview",
    "deploy": "pnpm --filter @tokenboard/web run deploy",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "@hono/vite-dev-server>@hono/node-server": "2.0.11",
      "@hono/vite-dev-server>minimatch": "10.2.5",
      "miniflare>sharp": "0.35.3",
      "miniflare>ws": "8.21.0",
      "minimatch@10.2.5>brace-expansion": "5.0.8",
      "postcss": "8.5.23",
      "tsx>esbuild": "0.28.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
