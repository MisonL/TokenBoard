# pnpm warns and installs on an unsupported Node unless this is set, which turns
# an engine mismatch into a working-looking install that fails later at runtime
# (node:sqlite, zstdDecompress, or a TLS bypass in an unpatched release). The
# floor itself lives in package.json `engines`; the range accepts only releases
# that carry the fixes for CVE-2026-111497 and the Node TLS hostname bypasses.
engine-strict=true
